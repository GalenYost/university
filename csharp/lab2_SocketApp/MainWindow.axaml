<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="lab2_SocketApp.MainWindow"
        Title="TCP Socket Chat" Width="500" Height="400"
        FontSize="14"
        KeyDown="OnWindowKeyDown">
    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="15">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
            <TextBlock Text="IP:" VerticalAlignment="Center"/>
            <TextBox Name="IpInput" Width="140" Text="100.x.x.x"/>
            <TextBlock Text="Port:" VerticalAlignment="Center"/>
            <TextBox Name="PortInput" Width="60" Text="8888"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
            <Button Content="Start server" Click="OnStartServerClick"/>
            <Button Content="Connect" Click="OnConnectClientClick"/>
            <TextBlock Name="StatusText" Text="Status: None" VerticalAlignment="Center" Foreground="Gray"/>
        </StackPanel>

        <ListBox Name="ChatBox" Grid.Row="2" Margin="0,0,0,10"/>

        <Grid Grid.Row="3" ColumnDefinitions="*, Auto">
            <TextBox
                Name="MessageInput"
                Grid.Column="0"
                Watermark="Enter message..."
                KeyDown="OnMessageInputKeyDown"
            />
            <Button Content="Send" Grid.Column="1" Margin="10,0,0,0" Click="OnSendMessageClick"/>
        </Grid>
    </Grid>
</Window>
