<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:n="using:NotaryApp"
        x:Class="lab1.DealDialog"
        Title="Угода" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="8">
        <TextBlock Text="Клієнт" />
        <ComboBox x:Name="ClientBox">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="n:Client">
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="Послуга" />
        <ComboBox x:Name="ServiceBox">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="n:Service">
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="Сума" />
        <TextBox x:Name="AmountBox" />
        <TextBlock Text="Комісійні (дохід контори)" />
        <TextBox x:Name="CommissionBox" />
        <TextBlock Text="Опис угоди" />
        <TextBox x:Name="DescriptionBox" AcceptsReturn="True" MinHeight="60" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button Content="ОК" Click="Ok_Click" Width="90" />
            <Button Content="Скасувати" Click="Cancel_Click" Width="110" />
        </StackPanel>
    </StackPanel>
</Window>