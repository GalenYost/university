<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="lab2.Views.Dialogs.QueryParamsDialog"
        Title="Параметри запиту" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="10">
        <TextBlock x:Name="TitleBlock" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" />
        <TextBlock x:Name="DescBlock" FontStyle="Italic" TextWrapping="Wrap" Foreground="Gray" />
        <Border Height="1" Background="#CCCCCC" Margin="0,4" />

        <StackPanel x:Name="ParamsPanel" Spacing="8" />

        <TextBlock x:Name="ErrorBlock" Foreground="Red" TextWrapping="Wrap" IsVisible="False" Margin="0,4,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button Content="Виконати" Click="Ok_Click" Width="100" />
            <Button Content="Скасувати" Click="Cancel_Click" Width="100" />
        </StackPanel>
    </StackPanel>
</Window>
